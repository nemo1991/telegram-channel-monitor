# tgmonitor 配置示例 —— 与 src/tgmonitor/core/config.py 的 Settings 字段一一对应
#
# 【放哪里】这份文件只是模板。应用读取的是**平台数据目录**下的 `.env`,不是仓库根,
# 也不相对当前工作目录:
#   macOS   ~/Library/Application Support/tgmonitor/.env
#   Linux   $XDG_DATA_HOME/tgmonitor/.env          (默认 ~/.local/share/tgmonitor)
#   Windows %LOCALAPPDATA%\tgmonitor\.env
# 【要不要手改】日常改配置走「设置」页面,保存后会保形写回 .env(权限 0600)。
# 手动编辑仅在首次部署 / headless 环境时有意义;路径类字段建议用绝对路径,写成相对
# 路径会相对**进程启动目录**解析。
# 【变量命名】环境变量 = TG_ + 字段名大写。同名进程环境变量优先级高于 .env。
# 【生效时机】经设置页或 `tgmon-cli config set` 修改会自动尝试热重载;直接手改
# .env 需重启应用才生效。

# ---- Telegram 凭据(https://my.telegram.org/apps 申请) ----
# 登录只有二维码扫码一种方式,只需 API ID / API Hash,不需要手机号。
# 两个命令:GUI 在登录对话框扫码;headless 用 `tgmon-cli login`。
TG_API_ID=000000
TG_API_HASH=00000000000000000000000000000000

# session 目录(登录后生成 tgmonitor.session,等同账号密码,勿外传 / 勿提交)。
# 默认:<数据目录>/session
# TG_SESSION_DIR=/absolute/path/to/session

# 代理(可选,目前只支持 SOCKS5;国内直连 Telegram 不通时常用)
# 格式:socks5://[user:pass@]host:port
# TG_PROXY=socks5://127.0.0.1:10808

# ---- 数据库后端 ----
# sqlite(默认,单文件零部署)| postgres(多设备 / 大规模)
TG_DB_BACKEND=sqlite
# SQLite 数据库文件路径。默认:<数据目录>/tgmonitor.db
# TG_SQLITE_PATH=/absolute/path/to/tgmonitor.db
# postgres 后端启用时填(asyncpg DSN):
# TG_DB_DSN=postgresql://tgmonitor:tgmonitor@localhost:5432/tgmonitor

# ---- 对象存储(媒体文件放哪) ----
# local(平铺)| folder(默认,两级分片,文件多时不慢)| s3
TG_OBJECTSTORE_BACKEND=folder
# local / folder 的根目录。默认:<数据目录>/media
# TG_OBJECTSTORE_ROOT=/absolute/path/to/media
# S3 协议(AWS S3 / MinIO / 阿里 OSS 等)启用时填:
# TG_OBJECTSTORE_ENDPOINT=http://localhost:9000
# TG_OBJECTSTORE_REGION=us-east-1
# TG_OBJECTSTORE_ACCESS_KEY=minioadmin
# TG_OBJECTSTORE_SECRET_KEY=minioadmin
# TG_OBJECTSTORE_BUCKET=tgmonitor

# ---- 媒体下载策略 ----
#   thumbnail(默认)— 记录元数据 + 下载缩略图,不下载原文件
#   full            — 额外下载原文件(占用更多流量与磁盘)
#   metadata        — 只记录元数据(UI 不暴露,CLI `sync --media-policy` 可选)
TG_MEDIA_POLICY=thumbnail
# 单文件下载上限(字节),0 = 无限制。默认 209715200(200 MiB);防止 full 模式
# 下超大文件撑爆本地 / 对象存储。
# TG_MEDIA_MAX_BYTES=209715200

# ---- 全量同步节奏(防封号;UI「全量同步」的默认间隔) ----
# 每条 API 调用之间的间隔,范围 50~60000 毫秒
# TG_SYNC_CHAT_DELAY_MS=500
# 每翻一页(约 100 条)之间的间隔,范围 100~60000 毫秒
# TG_SYNC_PAGE_DELAY_MS=1000
# 续拉:true(默认)时从库里已有最新消息之后拉,不重复
# TG_SYNC_RESUME_FROM_SAVED=true

# ---- 运行行为 ----
# 关闭窗口时:true = 真退出进程(默认)| false = 隐藏到托盘继续后台运行
# TG_CLOSE_ON_EXIT=true
# 启动时是否暂停监听:托盘点「暂停」后会写回此键,重启保持暂停
# TG_PAUSED=false

# ---- 数据目录(一般不用改) ----
# 日志(logs/tgmonitor.log,5MB × 3 轮转)等落在此目录。默认即上面的平台数据目录。
# TG_DATA_ROOT=/absolute/path/to/data-dir

# ---- 不走 .env 的环境变量 ----
# TG_LOG_LEVEL=DEBUG|INFO|WARNING|ERROR —— 只读进程环境变量(pydantic 不认这个键),
# 排查「一段时间不监听」时设 DEBUG 能看到 monitor 心跳。
#
# ---- 旧版遗留键 ----
# TG_PHONE(手机号登录已删)、TG_DB_ROOT(JSONL 后端已删)现在都没人读,旧 .env 里
# 残留无害(保存设置时会原样保留)。
