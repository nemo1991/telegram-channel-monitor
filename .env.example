# Telegram 凭据 — https://my.telegram.org/apps 申请
TG_API_ID=000000
TG_API_HASH=00000000000000000000000000000000
TG_PHONE=+10000000000

# 代理(可选,SOCKS5;TDLib 连接 DC 时使用,例: socks5://127.0.0.1:10808)
# TG_PROXY=socks5://127.0.0.1:10808

# 存储后端选择: postgres | mongo | jsonl(默认,无需 DB 服务)
TG_DB_BACKEND=jsonl
TG_DB_DSN=postgresql://tgmonitor:tgmonitor@localhost:5432/tgmonitor

# 对象存储后端选择: local | folder(默认,两级分片) | s3
TG_OBJECTSTORE_BACKEND=folder
TG_OBJECTSTORE_ROOT=./data/media
# S3 协议 (AWS S3 / MinIO / 阿里 OSS) 启用时填:
# TG_OBJECTSTORE_ENDPOINT=http://localhost:9000
# TG_OBJECTSTORE_REGION=us-east-1
# TG_OBJECTSTORE_ACCESS_KEY=minioadmin
# TG_OBJECTSTORE_SECRET_KEY=minioadmin
# TG_OBJECTSTORE_BUCKET=tgmonitor

# 媒体下载策略: metadata | thumbnail | full
TG_MEDIA_POLICY=thumbnail

# 2026-09-07 v1.6.8 i18n 二期:UI 语言 (zh_CN | en_US)。默认 zh_CN;
# 切换后写回 .env,下次启动生效。运行时可通过 Settings → 语言 下拉
# 即时切换,所有界面文字立即重译(无需重启)。
# TG_LANG=zh_CN
